		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@lucide/svelte": "^1.39.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"katex": "^0.18.5",
		"lucide-svelte": "^1.0.1"
	}
